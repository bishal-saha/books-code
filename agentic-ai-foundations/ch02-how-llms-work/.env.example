# Copy to .env (never committed) and check every value against your provider's docs.
# Last checked: 2026-11-16 (https://platform.claude.com/docs/en/about-claude/pricing,
# https://platform.claude.com/docs/en/build-with-claude/context-windows)
ANTHROPIC_API_KEY=
MODEL=claude-haiku-5-5
# USD per million tokens; this model's prompts up to 100,000 tokens.
INPUT_PRICE_PER_MTOK=0.10
OUTPUT_PRICE_PER_MTOK=0.50
CONTEXT_WINDOW_TOKENS=1000000
# Optional
KESTREL_DOCS_DIR=.kestrel/docs
MODEL_TIMEOUT_S=30
SAMPLING_MAX_TOKENS=1024
REASONING_MAX_TOKENS=16000
