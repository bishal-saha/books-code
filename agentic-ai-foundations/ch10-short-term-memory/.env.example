# Copy to .env (never committed) and fill in every empty value.
ANTHROPIC_API_KEY=
# A current model from your provider that supports tool calling.
MODEL=
# USD per million tokens, copied from your provider's pricing page.
INPUT_PRICE_PER_MTOK=
OUTPUT_PRICE_PER_MTOK=
# Optional (these are the defaults)
MAX_OUTPUT_TOKENS=1024
MODEL_TIMEOUT_S=30
MAX_RETRIES=1
KESTREL_URL=http://127.0.0.1:8700
# The run budget for one agent run (new in Chapter 7)
RUN_MAX_STEPS=8
RUN_MAX_TOKENS=60000
RUN_MAX_SECONDS=90
# The context budget (new in Chapter 9). Set CONTEXT_WINDOW from your provider's model page.
CONTEXT_WINDOW=100000
TOOL_RESULT_MAX_CHARS=16000
SYSTEM_CEILING_TOKENS=2000
TOOLS_CEILING_TOKENS=3000
CHARS_PER_TOKEN=4.0
# The context policy (new in Chapter 10): trim or compact the history before each model call.
# TRIM_TARGET_TOKENS = CONTEXT_WINDOW - system prompt - tool definitions - MAX_OUTPUT_TOKENS - margin.
CONTEXT_STRATEGY=trim
TRIM_TARGET_TOKENS=60000
COMPACTION_THRESHOLD_TOKENS=40000
COMPACTION_KEEP_UNITS=4
COMPACTION_MAX_TOKENS=1000
