# Copy to .env (never committed). Chapter 14 runs without a key: the tests and design_check
# use only local files. A key is needed from Chapter 15 on, for live runs.
ANTHROPIC_API_KEY=
# A current model from your provider that supports tool calling.
MODEL=
# The search service Chapter 15 picks: key sent in a request header, price per query.
SEARCH_API_KEY=
SEARCH_USD_PER_QUERY=

# The run budget for one question (these are the defaults; Chapter 16 tunes them)
RUN_MAX_STEPS=8
RUN_MAX_TOKENS=60000
RUN_MAX_SECONDS=120
RUN_MAX_COST_USD=0.50
SEARCH_TIMEOUT_S=10

# Optional (these are the defaults)
EXPORTS_DIR=.kestrel/exports
MAX_OUTPUT_TOKENS=1024
MODEL_TIMEOUT_S=30
MAX_RETRIES=1
TOOL_RESULT_MAX_CHARS=16000
CHARS_PER_TOKEN=4
PROMPT_VERSION=1
