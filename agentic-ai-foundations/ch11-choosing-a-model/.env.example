# Copy to .env (never committed) and fill in the values for the candidates you want to compare.
# A candidate whose variables are empty is reported as "not configured" and skipped.

# hosted-sdk: the Anthropic adapter. A current model from your provider that supports tool calling.
ANTHROPIC_API_KEY=
MODEL=

# hosted-compat-low-effort: any OpenAI-compatible endpoint (the adapter appends /chat/completions).
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# local-server: an inference server on your machine (not the Kestrel API). If it ignores keys,
# use a placeholder: an empty value counts as not configured.
LOCAL_COMPAT_BASE_URL=http://127.0.0.1:YOUR_PORT/v1
LOCAL_COMPAT_API_KEY=local-placeholder
LOCAL_COMPAT_MODEL=

# Optional (these are the defaults)
COMPARE_RUNS=3
MAX_OUTPUT_TOKENS=1024
MODEL_TIMEOUT_S=30
MAX_RETRIES=1
KESTREL_URL=http://127.0.0.1:8700
RUN_MAX_STEPS=8
RUN_MAX_TOKENS=60000
RUN_MAX_SECONDS=90
CONTEXT_WINDOW=100000
TOOL_RESULT_MAX_CHARS=16000
CHARS_PER_TOKEN=4.0
