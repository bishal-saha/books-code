# Copy to .env (never committed). Model and prices are examples copied from Chapter 2's
# template (last checked there: 2026-11-16). Check them again before use at
# https://platform.claude.com/docs/en/about-claude/pricing
ANTHROPIC_API_KEY=
# A current model from your provider that supports tool calling.
MODEL=claude-haiku-5-5
# USD per million tokens, from that page.
INPUT_PRICE_PER_MTOK=0.10
OUTPUT_PRICE_PER_MTOK=0.50
# Optional (these are the defaults)
MAX_OUTPUT_TOKENS=400
MODEL_TIMEOUT_S=30
MAX_RETRIES=2
# off sends thinking disabled. Some current models reject that: then set adaptive
# and raise MAX_OUTPUT_TOKENS, because thinking tokens count against it.
MODEL_THINKING=off
KESTREL_URL=http://127.0.0.1:8700
