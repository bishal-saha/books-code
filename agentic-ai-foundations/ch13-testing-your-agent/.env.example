# Copy to .env (never committed). Only `python -m ch13.eval --live` needs a key; the tests and
# the default eval run on the fake model.

# For --live --config hosted-sdk: a current model from your provider that supports tool calling.
ANTHROPIC_API_KEY=
MODEL=

# For --live with an OpenAI-compatible configuration in models.toml (see Chapter 11).
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# New in Chapter 13 (these are the defaults)
PROMPT_VERSION=1
EVAL_TRIALS=5
EVAL_MAX_COST_USD=0.50

# Optional (these are the defaults)
MAX_OUTPUT_TOKENS=1024
MODEL_TIMEOUT_S=30
MAX_RETRIES=1
KESTREL_URL=http://127.0.0.1:8700
RUN_MAX_TOKENS=60000
RUN_MAX_SECONDS=90
TOOL_RESULT_MAX_CHARS=16000
