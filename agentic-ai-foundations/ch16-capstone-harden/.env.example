# Copy to .env (never committed), then: uv run --env-file .env python -m ch16.cli "question"
# The tests and `--demo` runs need no key: they use the fake model and local files only.
ANTHROPIC_API_KEY=
# A current model from your provider that supports tool calling (--config hosted-sdk).
MODEL=
# For --config with an OpenAI-compatible configuration in models.toml (Chapter 11).
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# Your search service (HttpSearchBackend; adapt it to the service's API). Leave SEARCH_ENDPOINT
# empty to run without web search: search_web then says it isn't configured.
# With SEARCH_ENDPOINT set, SEARCH_USD_PER_QUERY is required: the money budget charges every
# request, retries included (Chapter 16).
SEARCH_ENDPOINT=
SEARCH_API_KEY=
SEARCH_USD_PER_QUERY=

# The run budget for one question (Chapter 14's defaults). RUN_MAX_COST_USD is enforced from
# Chapter 16, priced from the configuration's [config.price] in models.toml.
RUN_MAX_STEPS=8
RUN_MAX_TOKENS=60000
RUN_MAX_SECONDS=120
RUN_MAX_COST_USD=0.50
SEARCH_TIMEOUT_S=10

# New in Chapter 16: retries for search_web (transient failures only; the first try counts)
SEARCH_RETRY_ATTEMPTS=3
SEARCH_RETRY_BASE_S=0.5
SEARCH_RETRY_CAP_S=4.0

# Chapter 13's eval settings, for python -m ch16.eval
EVAL_TRIALS=5
EVAL_MAX_COST_USD=0.50

# Optional (these are the defaults)
EXPORTS_DIR=.kestrel/exports
MAX_OUTPUT_TOKENS=1024
MODEL_TIMEOUT_S=30
# The SDK's retries per model call: the only retry layer for model calls (Chapter 16)
MAX_RETRIES=1
TOOL_RESULT_MAX_CHARS=16000
CHARS_PER_TOKEN=4
PROMPT_VERSION=1

# Chapter 10's context policy (these are the defaults; one question stays far below them)
CONTEXT_STRATEGY=compact
TRIM_TARGET_TOKENS=40000
COMPACTION_THRESHOLD_TOKENS=24000
COMPACTION_KEEP_UNITS=4
COMPACTION_MAX_TOKENS=1000
