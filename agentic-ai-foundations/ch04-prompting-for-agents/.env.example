# Copy to .env (never committed). Only `compare` and the live test need a key.
ANTHROPIC_API_KEY=
# A current model from your provider.
MODEL=
# Optional (these are the defaults)
MAX_OUTPUT_TOKENS=400
MODEL_TIMEOUT_S=30
MAX_RETRIES=2
# off sends thinking disabled (see Chapter 3). Some current models reject disabling
# thinking: with them, set adaptive and raise MAX_OUTPUT_TOKENS.
MODEL_THINKING=off
KESTREL_URL=http://127.0.0.1:8700
